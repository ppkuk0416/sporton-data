# SQLite compatibility / isolated research only. .env is not loaded automatically.
SPORTON_HOME=var
SPORTON_DATABASE_URL=sqlite:///var/sporton.db
# PostgreSQL development: use python tools/runtime.py command ...
# File-based PostgreSQL credentials (psycopg is included in requirements.lock):
# SPORTON_DATABASE_URL_FILE=/run/secrets/sporton_database_url
# SPORTON_ENV=production requires PostgreSQL + sslmode=verify-full.
# SPORTON_ADMIN_TOKEN_FILE=/run/secrets/sporton_admin_token
# SPORTON_PERSISTENCE_CONFIG=config/persistence.production.example.json
# External provider keys are not required for CSV/local research.
